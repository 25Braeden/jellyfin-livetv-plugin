# Local Jellyfin state (config, cache, db)
local/*
!local/.gitkeep

# Real tuner playlists may contain provider credentials
tuners/*
!tuners/tuner1.m3u
!tuners/tuner2.m3u

# Secrets
.env

# Test media
test-media/*
!test-media/.gitkeep

# .NET build output
bin/
obj/
.DS_Store

# Python bytecode
__pycache__/

# Release packages (scripts/package_release.sh)
dist/

# Generated review bundles (regenerate; never commit)
review/bundle-*.txt
